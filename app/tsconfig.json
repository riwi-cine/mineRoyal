{
  "module": "commonjs",
  "moduleResolution": "node",
  "esModuleInterop": true,
  "emitDecoratorMetadata": true,
  "experimentalDecorators": true,
  "target": "ES2022",
  "sourceMap": true,
  "outDir": "./dist",
  "rootDir": "./src",
  "strict": true,
  "strictPropertyInitialization": false,
  "skipLibCheck": true,
  "declaration": true,
  "removeComments": true,
  "types": ["node"],
  "lib": ["ES2022"]
}
